# FormFit AI Environment Configuration
PROJECT_NAME="FormFit AI"
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Database
DATABASE_PATH=data/formfit.db

# MediaPipe & Vision Pipeline
POSE_MODEL_COMPLEXITY=1
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5
MIN_LANDMARK_VISIBILITY=0.6

# Smoothing Configuration
SMOOTHING_ENABLED=true
SMOOTHING_METHOD=ema  # "ema" or "one_euro"
SMOOTHING_ALPHA=0.65  # EMA smoothing factor (0.0 - 1.0)
ONE_EURO_MIN_CUTOFF=1.0
ONE_EURO_BETA=0.007

# Media Limits
MAX_UPLOAD_SIZE_MB=50
DEMO_DIR=backend/data/demo
